    <string name="privacy_title">Privacy</string>
    <string name="privacy_hint">What’s stored on this device</string>
    <string name="privacy_intro">Errata is published by Ordinary Tools. Your upkeep list stays on this device. There is no Errata account and no Ordinary Tools servers. Linking Google is optional. Contact: ordinary.tools.apps@gmail.com</string>
    <string name="privacy_heading_stored">What’s stored</string>
    <string name="privacy_stored">Tasks, completion history, and settings live in the app’s local database. History can be trimmed or cleared in Settings. If you choose a backup folder, that folder’s address is remembered on this device only (it is not inside the exported JSON). If you link Google, a copy also lives in your Drive app folder.</string>
    <string name="privacy_heading_not">What isn’t collected</string>
    <string name="privacy_not">No ads, analytics, or crash reporters. There is no Errata server. If you link Google, task titles, notes, and history are sent to Google Drive app data over HTTPS. Unlink stops that. Uninstall does not delete the Drive copy unless you choose to delete it in Settings.</string>
    <string name="privacy_heading_permissions">Permissions</string>
    <string name="privacy_permissions">Internet only to talk to Google when you opt in to Drive app data. Notifications for reminders. Boot completed so reminders can be rescheduled after reboot. Optional exact alarms on Android 12+ so they can fire at the time you picked. Files and folders through the system picker when you export, import, or choose a folder.</string>
    <string name="privacy_heading_copies">Copies you make</string>
    <string name="privacy_copies">Export, import, and folder write/read are things you start. Import replaces all data here after you confirm. If Google is linked, import then uploads so the Drive copy follows this device. Optional Google link stores a hidden app file in your Drive — not a file you pick in the sheet.</string>
    <string name="privacy_heading_system">System backup</string>
    <string name="privacy_system">Android cloud backup of Errata data is off. Move to another phone or tablet with Backup export or the folder file. Reminders are local. Errata is not a medical device.</string>
    <string name="settings_footer">No Errata account. Link Google only if you want phone and tablet to share a hidden Drive copy.</string>
    <string name="settings_google">Google</string>
    <string name="settings_google_hint">Optional. Sign in with Google to keep this list in a hidden Drive app folder. Errata has no account of its own.</string>
