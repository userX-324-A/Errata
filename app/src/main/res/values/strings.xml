    <string name="privacy_title">Privacy</string>
    <string name="privacy_hint">What’s stored on this device</string>
    <string name="privacy_intro">Errata keeps your upkeep list on this device. There is no Errata account and no Errata servers.</string>
    <string name="privacy_heading_stored">What’s stored</string>
    <string name="privacy_stored">Tasks, completion history, and settings live in the app’s local database. If you choose a backup folder, that folder’s address is remembered on this device only (it is not inside the exported JSON).</string>
    <string name="privacy_heading_not">What isn’t collected</string>
    <string name="privacy_not">No ads, analytics, or crash reporters. The app has no internet permission, so it cannot send task titles or anything else to a network.</string>
    <string name="privacy_heading_permissions">Permissions</string>
    <string name="privacy_permissions">Notifications for reminders. Boot completed so reminders can be rescheduled after reboot. Optional exact alarms on Android 12+ so they can fire at the time you picked. Files and folders only through the system picker when you export, import, or choose a folder.</string>
    <string name="privacy_heading_copies">Copies you make</string>
    <string name="privacy_copies">Export, import, and folder write/read are things you start. Import replaces all data here after you confirm. If you pick Drive in the system sheet, that copy is yours — Errata does not sign into Drive.</string>
    <string name="privacy_heading_system">System backup</string>
    <string name="privacy_system">Android cloud backup of Errata data is off. Move to another phone or tablet with Backup export or the folder file. Reminders are local. Errata is not a medical device.</string>
    <string name="settings_footer">Everything stays on this device. No account.</string>
